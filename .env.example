# --- Runtime ----------------------------------------------------------------
# Company timezone — attendance/payroll date math runs in this zone regardless
# of the host's clock (defaults to Asia/Kolkata when unset).
# TZ=Asia/Kolkata
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (local Postgres now; AWS RDS Postgres once DevOps hands over) --
# Either a single URL...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elecbits_hr
# ...or discrete parts (used when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=elecbits_hr
# PGUSER=postgres
# PGPASSWORD=postgres

# TLS for RDS. Leave false for local dev. For RDS, set PGSSL=true and download
# the CA bundle: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
PGSSL=false
# PGSSL_CA=certs/global-bundle.pem

# --- HTTP -------------------------------------------------------------------
# Allowed CORS origins, comma-separated (the frontend dev server by default).
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=100kb
# TRUST_PROXY=1

# --- Auth (local JWT — no Supabase / no external IdP) -----------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
# Rotating refresh token (httpOnly cookie): sliding lifetime, and SameSite
# (lax while app + API share a site; none + HTTPS for a cross-site deploy).
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SAMESITE=lax

# Company email domain: sign-in is restricted to this domain (design doc §5.4).
COMPANY_EMAIL_DOMAIN=elecbits.in
# The one email allowed to claim the organization on first sign-in (§5.2).
OWNER_CLAIM_EMAIL=admin@elecbits.in

# --- App --------------------------------------------------------------------
# Frontend base URL (used for links in notifications/invites later).
APP_URL=http://localhost:5173

# --- Email -------------------------------------------------------------------
# log = write emails to the server log only (default); gmail = send via the
# Gmail API (service account + domain-wide delegation, scope gmail.send).
# Nothing is sent until Admin -> Settings -> Email delivery is also switched on.
EMAIL_DRIVER=log
EMAIL_FROM=no-reply@elecbits.in
EMAIL_FROM_NAME=Elecbits HR
EMAIL_REPLY_TO=hr@elecbits.in
# Testing: send EVERY email to this one address instead of the real person.
EMAIL_REDIRECT_TO=
# The service account JSON key (the JSON itself, or a path to the file). Secret.
GOOGLE_SERVICE_ACCOUNT_KEY=

# --- Google sign-in (SSO) ----------------------------------------------------
# OAuth 2.0 (auth code + PKCE). Leave the id/secret blank to keep SSO off (the
# password form stays the only way in). The redirect URI must match one listed
# on the OAuth client in Google Cloud.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# --- File storage (Google Drive) ---------------------------------------------
# db = keep uploaded files in Postgres (default); drive = store them in the
# company Shared Drive (needs GOOGLE_SERVICE_ACCOUNT_KEY above + the id below).
STORAGE_DRIVER=db
# The Shared Drive id — the part of the drive.google.com URL after /folders/.
DRIVE_SHARED_DRIVE_ID=

# --- Attendance --------------------------------------------------------------
# Geo punch policy: inside OFFICE_RADIUS_M (meters from OFFICE_LAT/LNG) punches
# record as office; beyond it (or with location denied) punching is BLOCKED
# unless an approved remote-work request (WFH / client visit / remote) covers
# the day. WORK_START/WORK_END (+grace) drive the late/early punctuality dots.
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_M=250
# Testing only (ignored in production): true lets a punch from this machine with
# no location count as inside a zone. Leave unset to test the real zone check.
ATTENDANCE_DEV_LOOPBACK=
WORK_START=09:30
WORK_END=18:30
WORK_GRACE_MIN=15

# --- AI (optional) ---
# Work-update scoring + the HR Assistant chat. No key = both stay off.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# ANTHROPIC_ASSISTANT_MODEL=claude-opus-5-5
