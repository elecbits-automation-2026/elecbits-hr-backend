# --- Runtime ----------------------------------------------------------------
# Company timezone — attendance/payroll date math runs in this zone regardless
# of the host's clock (defaults to Asia/Kolkata when unset).
# TZ=Asia/Kolkata
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug

# --- Database (local Postgres now; AWS RDS Postgres once DevOps hands over) --
# Either a single URL...
DATABASE_URL=postgres://postgres:postgres@localhost:5432/elecbits_hr
# ...or discrete parts (used when DATABASE_URL is unset):
# PGHOST=localhost
# PGPORT=5432
# PGDATABASE=elecbits_hr
# PGUSER=postgres
# PGPASSWORD=postgres

# TLS for RDS. Leave false for local dev. For RDS, set PGSSL=true and download
# the CA bundle: https://truststore.pki.rds.amazonaws.com/global/global-bundle.pem
PGSSL=false
# PGSSL_CA=certs/global-bundle.pem

# --- HTTP -------------------------------------------------------------------
# Allowed CORS origins, comma-separated (the frontend dev server by default).
CORS_ORIGIN=http://localhost:5173
BODY_LIMIT=100kb
# TRUST_PROXY=1

# --- Auth (local JWT — no Supabase / no external IdP) -----------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=15m
# Rotating refresh token (httpOnly cookie): sliding lifetime, and SameSite
# (lax while app + API share a site; none + HTTPS for a cross-site deploy).
REFRESH_TOKEN_TTL_DAYS=7
REFRESH_COOKIE_SAMESITE=lax

# Company email domain: sign-in is restricted to this domain (design doc §5.4).
COMPANY_EMAIL_DOMAIN=elecbits.in
# The one email allowed to claim the organization on first sign-in (§5.2).
OWNER_CLAIM_EMAIL=admin@elecbits.in

# --- App --------------------------------------------------------------------
# Frontend base URL (used for links in notifications/invites later).
APP_URL=http://localhost:5173

# --- Attendance --------------------------------------------------------------
# Geo punch policy: inside OFFICE_RADIUS_M (meters from OFFICE_LAT/LNG) punches
# record as office; beyond it (or with location denied) punching is BLOCKED
# unless an approved remote-work request (WFH / client visit / remote) covers
# the day. WORK_START/WORK_END (+grace) drive the late/early punctuality dots.
OFFICE_LAT=
OFFICE_LNG=
OFFICE_RADIUS_M=250
WORK_START=09:30
WORK_END=18:30
WORK_GRACE_MIN=15

