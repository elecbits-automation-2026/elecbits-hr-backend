{
  "name": "elecbits-hr-backend",
  "version": "0.1.0",
  "description": "Elecbits HRMS backend — org structure, batch-based access control, OPS assets, and exit clearance",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed-modules": "tsx src/scripts/seed-modules.ts",
    "db:seed-policies": "tsx src/scripts/seed-policies.ts",
    "db:seed-batches": "tsx src/scripts/seed-batches.ts",
    "db:seed-asset-categories": "tsx src/scripts/seed-asset-categories.ts",
    "db:seed-test-employees": "tsx src/scripts/seed-test-employees.ts",
    "db:seed-test-activity": "tsx src/scripts/seed-test-activity.ts",
    "docs:schema": "tsx src/scripts/gen-schema-doc.ts && prettier --write docs/database-schema.md",
    "db:studio": "drizzle-kit studio --config=drizzle.config.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^8.5.0",
    "bcryptjs": "^3.0.2",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-async-errors": "^3.1.1",
    "helmet": "^8.2.0",
    "http-errors": "^2.0.1",
    "jsonwebtoken": "^9.0.2",
    "pdfkit": "^0.17.2",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/http-errors": "^2.0.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.10.5",
    "@types/pdfkit": "^0.17.3",
    "@types/pg": "^8.11.10",
    "@types/swagger-ui-express": "^4.1.7",
    "drizzle-kit": "^0.31.10",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.8.4",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
